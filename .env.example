# CyberLLM environment configuration
# Copy this file to .env and adjust values for your environment.

# --- LLM Provider ---
# Provider: "ollama" (local, default) or "openai"
CYBERLLM_PROVIDER=ollama

# Model name (Ollama: llama3.2, mistral, etc. | OpenAI: gpt-4o, gpt-4o-mini)
CYBERLLM_MODEL=llama3.2

# Ollama endpoint (used when provider=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI API key (used when provider=openai)
# OPENAI_API_KEY=sk-...

# LLM generation parameters
CYBERLLM_TEMPERATURE=0.1
CYBERLLM_MAX_TOKENS=1000

# --- Threat Intelligence ---
# Enable threat intel enrichment (true/false)
CYBERLLM_ENABLE_TI=false

# VirusTotal API key (optional, required for VT enrichment)
# VT_API_KEY=...

# AbuseIPDB API key (optional)
# ABUSEIPDB_API_KEY=...

# --- Analysis ---
# Maximum log lines to send to the LLM in one call
CYBERLLM_MAX_LINES=200

# Enable MITRE ATT&CK technique mapping
CYBERLLM_ENABLE_MITRE=true

# --- Reporting ---
# Default report format: markdown, json, siem
CYBERLLM_DEFAULT_FORMAT=markdown

# Output directory for reports
CYBERLLM_OUTPUT_DIR=./reports